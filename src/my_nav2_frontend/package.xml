<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_nav2_frontend</name>
  <version>0.1.0</version>
  <description>PCL voxel filter and small_gicp frontend for consecutive lidar frames.</description>
  <maintainer email="hzy@todo.todo">zy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>
  <build_depend>libpcl-all-dev</build_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
